<mvc:View controllerName="project1.controller.admobility"
	xmlns:mvc="sap.ui.core.mvc"
	xmlns:core="sap.ui.core"
	xmlns="sap.m"
	xmlns:l="sap.ui.layout"
	xmlns:f="sap.ui.layout.form"
	xmlns:card="sap.f.cards"
	xmlns:f1="sap.f" displayBlock="true"
	xmlns:w="sap.ui.integration.widgets"
	xmlns:cssgrid="sap.ui.layout.cssgrid"
	xmlns:form="sap.ui.layout.form"
	xmlns:u="sap.ui.unified"
	xmlns:commons="sap.suite.ui.commons" class="d-flex justify-content-center" height="94%">
	<Page id="enableadisableef" title="{i18n>VehicleInspection}" showNavButton="true" navButtonPress="backToLanding">
		<VBox class="sapUiSmallMargin">
			<f:SimpleForm id="SimpleFormChangeColumn_threeGroups234" editable="true" layout="ColumnLayout" title="{i18n>CustomerSearch}" columnsM="3" columnsL="3" columnsXL="4">
				<Toolbar>

					<!-- <Title text="{i18n>VehicleandCustomerDetails}" /> -->
					<!-- <HBox class="sapUiTinyMarginBottom" alignItems="Center">
						<Button icon="sap-icon://camera" width="5rem" class="sapUiTinyMarginEnd"/>
						<ObjectStatus text="5 Sec" state="Information" />

					</HBox> -->
					<ToolbarSpacer />
					<Button id="BtnAd" type="Emphasized" text="{i18n>AddMobility}" press="onInfoMessageBoxPress" />
					<Button type="Reject" text="{i18n>Reset}" press="onPress" />

				</Toolbar>
				<f:content>

					<Label text="{i18n>PlateNumber}" />
					<Input id="name1" width="7rem" />
					<Button icon="sap-icon://camera" width="5rem"/>
					<!-- <ObjectStatus id="Timerset" text="{/iTimeLeft} Sec" state="Information" /> -->
					<ObjectStatus id="Timerset" text="{/iTimeLeft} Sec" state="Error" />
					<Label text="{i18n>PlateColorCode}" />
					<Input value="{/Carcolor}">
						<layoutData>
							<f:ColumnElementData cellsSmall="3" cellsLarge="1" />
						</layoutData>
					</Input >
					<Input value="{/CarCode}" />
					<Label text="{i18n>Purpose}" />
					<ComboBox items="{
					path: 'PurposeModel>/value',
					sorter: { path: 'text' }
			     	}">
						<core:Item key="{PurposeModel>PurposeCode}" text="{PurposeModel>PurposeName}" />
					</ComboBox>
					<Label text="{i18n>MainPurpose}" />
					<Select id="MainPurpose" selectedKey="{Country}">
						<items>
							<core:Item text="" key=""/>
						</items>
					</Select>
					<Label text="" />
					<CheckBox text="{i18n>UnRegistered}" />

					<RadioButton text="{i18n>Individual}" selected="true" />
					<RadioButton text="{i18n>Corporate}" />
				</f:content>
			</f:SimpleForm>
		</VBox>
		<HBox class="sapUiMediumMargin">
			<FlexBox>
				<f1:Card class="sapUiMediumMargin" width="300px" height="auto">
					<f1:header>
						<card:Header title="{i18n>VehicleDetails}" iconSrc="https://imgs.search.brave.com/9DSaVgWkCSlmzTzznJjy7q12970zJp8iNp08YuaEK2g/rs:fit:500:0:0:0/g:ce/aHR0cHM6Ly90NC5m/dGNkbi5uZXQvanBn/LzA5LzY3LzMzLzgx/LzM2MF9GXzk2NzMz/ODEzMV91SnFMcXVO/VUNnWWRyVzJPODZI/MVlLcDFXbnlhT2g4/Ui5qcGc" />


					</f1:header>
					<f1:content>
						<FlexBox justifyContent="SpaceAround" alignItems="Center" class="sapUiSmallMargin">
							<VBox class="sapUiSmallMarginBottom" justifyContent="SpaceAround">

								<HBox alignItems="Center" class="sapUiSmallMarginBottom">
									<Text text="{i18n>ChassisNo}:" />
									<ObjectStatus id="ChassisNo" text="{ADMobility>/ChassisNo}" state="Information" />
								</HBox>

								<HBox alignItems="Center" class="sapUiSmallMarginBottom">

									<Text text="{i18n>EngineNo}:" />
									<ObjectStatus text="{ADMobility>/EngineNo}" state="Information" />

								</HBox>


								<HBox alignItems="Center" class="sapUiSmallMarginBottom">

									<Text text="{i18n>Country}:" />
									<ObjectStatus text="{ADMobility>/Country}" state="Information" />

								</HBox>

								<HBox alignItems="Center" class="sapUiSmallMarginBottom">

									<Text text="{i18n>Manufacturer}:" />
									<ObjectStatus text="{ADMobility>/Manufacturer}" state="Information" />


								</HBox>
								<!-- <HBox alignItems="Center" class="sapUiSmallMarginBottom">

									<Text text="Manufacturer Des:" />
									<ObjectStatus text="{ADMobility>/ManufacturerArabic}" state="Information" />


								</HBox> -->

								<HBox alignItems="Center" class="sapUiSmallMarginBottom">

									<Text text="{i18n>Model}:" />
									<ObjectStatus text="{ADMobility>/Model}" state="Information" />

								</HBox>

								<HBox alignItems="Center" class="sapUiSmallMarginBottom">

									<Text text="{i18n>Kind}:" />
									<ObjectStatus text="{ADMobility>/Kind}" state="Information" />

								</HBox>

								<HBox alignItems="Center" class="sapUiSmallMarginBottom">

									<Text text="{i18n>Type}:" />
									<ObjectStatus text="{ADMobility>/Type}" state="Information" />

								</HBox>

								<HBox alignItems="Center" class="sapUiSmallMarginBottom">

									<Text text="{i18n>GearType}:" />
									<ObjectStatus text="{ADMobility>/GearType}" state="Information" />


								</HBox>


								<HBox alignItems="Center" class="sapUiSmallMarginBottom">

									<Text text="{i18n>FuelType}:" />
									<ObjectStatus text="{ADMobility>/GearType}" state="Information" />


								</HBox>

								<HBox alignItems="Center" class="sapUiSmallMarginBottom">

									<Text text="{i18n>SteeringSide}:" />
									<ObjectStatus text="{ADMobility>/SteeringSide}" state="Information" />


								</HBox>

								<HBox alignItems="Center" class="sapUiSmallMarginBottom">

									<Text text="{i18n>WeightKind}:" />
									<ObjectStatus text="{ADMobility>/Kind}" state="Information" />


								</HBox>

							</VBox>

						</FlexBox>
					</f1:content>
				</f1:Card>
				<f1:Card class="sapUiMediumMargin" width="300px" height="auto">

					<f1:content>
						<FlexBox justifyContent="SpaceAround" alignItems="Center" class="sapUiSmallMargin">
							<VBox class="sapUiSmallMarginBottom" justifyContent="SpaceAround">

								<HBox alignItems="Center" class="sapUiSmallMarginBottom">
									<Text text="{i18n>InitRegYear}:" />
									<ObjectStatus text="{ADMobility>/RegistrationYear}" state="Information" />
								</HBox>


								<HBox alignItems="Center" class="sapUiSmallMarginBottom">

									<Text text="{i18n>RegExpDate}:" />
									<ObjectStatus text="{ADMobility>/RegistrationExpYear}" state="Information" />


								</HBox>


								<HBox alignItems="Center" class="sapUiSmallMarginBottom">

									<Text text="{i18n>PlateType}:" />
									<ObjectStatus text="{ADMobility>/PlateType}" state="Information" />

								</HBox>

								<HBox alignItems="Center" class="sapUiSmallMarginBottom">

									<Text text="{i18n>MFGYear}:" />
									<ObjectStatus text="{ADMobility>/ManufacturerYear}" state="Information" />


								</HBox>

								<HBox alignItems="Center" class="sapUiSmallMarginBottom">

									<Text text="{i18n>HorsePower}:" />
									<ObjectStatus text="{ADMobility>/Horsepower}" state="Information" />


								</HBox>

								<HBox alignItems="Center" class="sapUiSmallMarginBottom">

									<Text text="{i18n>NoofAxles}:" />
									<ObjectStatus text="{ADMobility>/NumberOfAxles}" state="Information" />

								</HBox>

								<HBox alignItems="Center" class="sapUiSmallMarginBottom">

									<Text text="{i18n>NoofCylinders}:" />
									<ObjectStatus text="{ADMobility>/NumberOfCylinders}" state="Information" />

								</HBox>

								<HBox alignItems="Center" class="sapUiSmallMarginBottom">

									<Text text="{i18n>NoofWheels}:" />
									<ObjectStatus text="{ADMobility>/NumberOfWheels}" state="Information" />

								</HBox>

								<HBox alignItems="Center" class="sapUiSmallMarginBottom">

									<Text text="{i18n>NoofPassengers}:" />
									<ObjectStatus text="{ADMobility>/NumberOfPassengers}" state="Information" />


								</HBox>
								<HBox alignItems="Center" class="sapUiSmallMarginBottom">

									<Text text="{i18n>EmptyWeight}:" />
									<ObjectStatus text="{ADMobility>/EmptyWeight}" state="Information" />


								</HBox>

								<HBox alignItems="Center" class="sapUiSmallMarginBottom">

									<Text text="{i18n>FullWeight}:" />
									<ObjectStatus text="{ADMobility>/FullWeight}" state="Information" />


								</HBox>

								<HBox alignItems="Center" class="sapUiSmallMarginBottom">

									<Text text="{i18n>Mileage}:" />
									<ObjectStatus text="{ADMobility>/Mileage}" state="Information" />


								</HBox>

								<HBox alignItems="Center" class="sapUiSmallMarginBottom">

									<Text text="{i18n>CubicCapacity}:" />
									<ObjectStatus text="{ADMobility>/CubicCapacity}" state="Information" />


								</HBox>

							</VBox>
							<HBox>

							</HBox>
						</FlexBox>
					</f1:content>
				</f1:Card>



				<f1:Card id="Card_3" class="sapUiMediumMargin" width="300px" height="auto">
					<f1:header>

						<card:Header title="Customer Details" iconSrc="https://ui5.sap.com/test-resources/sap/ui/integration/demokit/sample/CardsLayout/images/Avatar_1.png" subtitle="{data>/VehicleDetail/CustomerData/PastalCode}" />

					</f1:header>

					<f1:content>
						<FlexBox justifyContent="SpaceAround" alignItems="Center" class="sapUiSmallMargin">
							<VBox class="sapUiSmallMarginBottom" justifyContent="SpaceAround">



								<HBox alignItems="Center" class="sapUiSmallMarginBottom">
									<Text text="Name:" />
									<ObjectStatus text="{data>/VehicleDetail/CustomerData/Name}" state="Information" />
								</HBox>


								<HBox alignItems="Center" class="sapUiSmallMarginBottom">

									<Text text="{i18n>Email}:" />
									<ObjectStatus text="{data>/VehicleDetail/CustomerData/Email}" state="Information" />

								</HBox>


								<HBox alignItems="Center" class="sapUiSmallMarginBottom">

									<Text text="{i18n>Mobile}:" />
									<ObjectStatus text="{data>/VehicleDetail/CustomerData/Mobile}" state="Information" />

								</HBox>

								<HBox alignItems="Center" class="sapUiSmallMarginBottom">

									<Text text="{i18n>City}:" />
									<ObjectStatus text="{data>/VehicleDetail/CustomerData/City}" state="Information" />


								</HBox>

								<HBox alignItems="Center" class="sapUiSmallMarginBottom">

									<Text text="{i18n>PastalCode}:" />
									<ObjectStatus text="{data>/VehicleDetail/CustomerData/PastalCode}" state="Information" />

								</HBox>

								<HBox alignItems="Center" class="sapUiSmallMarginBottom">

									<Text text="{i18n>Address}:" />
									<ObjectStatus text="{data>/VehicleDetail/CustomerData/Address}" state="Information" />

								</HBox>


							</VBox>
						</FlexBox>
					</f1:content>
				</f1:Card>

			</FlexBox>
		</HBox>
		<footer>
			<Toolbar>
				<Button type="Default" id="CustomerCreate" text="Create Vehicle" press="goToCreateVeh" icon="sap-icon://add-employee"/>
				<ToolbarSpacer />
				<FlexBox justifyContent="End">

					<Button type="Emphasized" id="Retest" text="Reset" press="onSave" class="sapUiSmallMarginBegin"/>
					<Button type="Emphasized" id="Proceed" text="Proceed" press="onSaveSO" class="sapUiSmallMarginBegin"/>
				</FlexBox>
			</Toolbar>
		</footer>
	</Page>
</mvc:View>